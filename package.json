{
  "name": "greenlogistics-attendance",
  "version": "1.0.0",
  "description": "Green Logistics Attendance Management System",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:fast": "prisma db push --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:push:postgres": "prisma db push --schema=prisma/schema.postgresql.prisma",
    "setup:postgres": "npm run db:generate:postgres && npm run db:push:postgres && npm run db:seed",
    "deploy:build": "npm run db:generate && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
