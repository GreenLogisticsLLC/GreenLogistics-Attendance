DATABASE_URL="file:./data/attendance.db"
# Runtime + deploy pin this to an absolute path so Prisma CLI and the app
# share one SQLite file (CLI otherwise uses prisma/data/, app uses ./data/).
# For PostgreSQL production, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/greenlogistics_attendance"
JWT_SECRET="change-this-to-a-long-random-secret-key"
WEBHOOK_SECRET="change-this-webhook-bearer-token"
API_PORT=3847
# On Contabo / Node, PORT may be set by the process manager — do not override unless needed.
PUBLIC_APP_URL=https://os.greengrouplogistics.com
CORS_ORIGINS=https://greengrouplogistics.com,https://www.greengrouplogistics.com,https://os.greengrouplogistics.com
TIMEZONE=America/Los_Angeles
COMPANY_NAME=Green Logistics
LOG_LEVEL=info

# =============================================================================
# Mail — three independent roles (do not share one Gmail mailbox across roles)
# =============================================================================

# Role 1 — Gmail API inbound (uShip / load-board import ONLY)
# Connect via GET /api/email/auth after setting client id/secret.
# Do NOT use this account as SMTP_USER / SMTP_FROM.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional manual token; normally obtained via GET /api/email/auth
GMAIL_REFRESH_TOKEN=
GMAIL_USER=effiegreenlogistics@gmail.com
# Must match Google Cloud "Authorized redirect URIs"
# Default: {PUBLIC_APP_URL}/api/email/callback
# GMAIL_REDIRECT_URI=https://os.greengrouplogistics.com/api/email/callback
# Optional Gmail label ID to mark processed messages
GMAIL_PROCESSED_LABEL_ID=
EMAIL_POLL_INTERVAL_MS=30000

# Role 2 — Approval recipient (Owner / admin inbox for new agent signup)
# This is only the "To:" address. Sending still uses SMTP_* below.
APPROVAL_EMAIL=osgreenlogistics@gmail.com

# Role 3 — Outbound SMTP (system emails: signup approval links, etc.)
# Gmail App Password required (Account → Security → 2-Step → App passwords).
# Normal Gmail password fails with 535 BadCredentials.
# Keep this separate from GMAIL_USER (uShip import).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=osgreenlogistics@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM=osgreenlogistics@gmail.com

# Legacy Reader — sync employee cards TO access control device
LEGACY_API_URL=https://your-reader-server.example.com
LEGACY_INGEST_TOKEN=your-ingest-token-from-partner
