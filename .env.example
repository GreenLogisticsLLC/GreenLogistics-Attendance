DATABASE_URL="file:./data/attendance.db"
# For PostgreSQL production, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/greenlogistics_attendance"
JWT_SECRET="change-this-to-a-long-random-secret-key"
WEBHOOK_SECRET="change-this-webhook-bearer-token"
API_PORT=3847
# On Contabo / Node, PORT may be set by the process manager — do not override unless needed.
PUBLIC_APP_URL=https://os.greengrouplogistics.com
CORS_ORIGINS=https://greengrouplogistics.com,https://www.greengrouplogistics.com,https://os.greengrouplogistics.com
TIMEZONE=America/Los_Angeles
COMPANY_NAME=Green Logistics
LOG_LEVEL=info

# Registration approval emails
APPROVAL_EMAIL=osgreenlogistics@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=osgreenlogistics@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=osgreenlogistics@gmail.com

# Legacy Reader — sync employee cards TO access control device
LEGACY_API_URL=https://your-reader-server.example.com
LEGACY_INGEST_TOKEN=your-ingest-token-from-partner
