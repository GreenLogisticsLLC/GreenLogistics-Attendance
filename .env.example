DATABASE_URL="file:./data/attendance.db"
# Runtime + deploy pin this to an absolute path so Prisma CLI and the app
# share one SQLite file (CLI otherwise uses prisma/data/, app uses ./data/).
# For PostgreSQL production, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/greenlogistics_attendance"
JWT_SECRET="change-this-to-a-long-random-secret-key"
WEBHOOK_SECRET="change-this-webhook-bearer-token"
API_PORT=3847
# On Contabo / Node, PORT may be set by the process manager — do not override unless needed.
PUBLIC_APP_URL=https://os.greengrouplogistics.com
# Carrier onboarding secure link lifetime (days). Default 7.
CARRIER_ONBOARDING_EXPIRY_DAYS=7
CORS_ORIGINS=https://greengrouplogistics.com,https://www.greengrouplogistics.com,https://os.greengrouplogistics.com
TIMEZONE=America/Los_Angeles
COMPANY_NAME=Green Logistics
LOG_LEVEL=info

# =============================================================================
# Mail
# =============================================================================

# Inbox #1 — effie: READ (uShip import) + receive signup approval notices
# Connect Gmail API via GET /api/email/auth (login as effie).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=effiegreenlogistics@gmail.com
# GMAIL_REDIRECT_URI=https://os.greengrouplogistics.com/api/email/callback
GMAIL_PROCESSED_LABEL_ID=
EMAIL_POLL_INTERVAL_MS=30000

# Where Approve/Reject emails are delivered (open this Gmail to confirm employees)
APPROVAL_EMAIL=effiegreenlogistics@gmail.com

# Outbound sender — system mailbox with Gmail App Password (preferred).
# If SMTP fails (535 BadCredentials), Green OS falls back to Gmail API send
# using the connected OAuth mailbox (GMAIL_USER / effie) so approvals still arrive.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=osgreenlogistics@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM=osgreenlogistics@gmail.com

# Legacy Reader — sync employee cards TO access control device
LEGACY_API_URL=https://your-reader-server.example.com
LEGACY_INGEST_TOKEN=your-ingest-token-from-partner

# =============================================================================
# GreenOS AI Assistant (OpenAI)
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Required for project-scoped keys (sk-proj-...) — from OpenAI project/org settings.
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=
# Use a Project API key (sk-proj-...), NOT an Admin key (sk-admin-...).
# Phase 1 AI foundation
AI_ENABLED=true
# Phase 8 computed operational attention center (default true).
AI_COMMAND_CENTER_ENABLED=true
# Per-user chat requests allowed per rolling 60s window (server-side).
# Phase 2 Document AI
# Optional: enable paid vision for uncertain signatures (default off — heuristics + REVIEW).
DOC_AI_VISION=false

# =============================================================================
# GreenOS Market Rate Engine (Phase 5A internal + Phase 5B external architecture)
# Server-side only — never expose credentials to frontend.
# =============================================================================
MARKET_RATES_ENABLED=true
# Generic provider runner defaults — provider-specific limits: PENDING OFFICIAL API DOCUMENTATION
MARKET_RATE_PROVIDER_TIMEOUT_MS=8000
MARKET_RATE_PROVIDER_RETRY_COUNT=0

# DAT — NOT CONNECTED in Phase 5B (architecture stub only)
DAT_MARKET_RATES_ENABLED=false
DAT_API_BASE_URL=
# PENDING OFFICIAL API DOCUMENTATION — exact auth fields may differ
DAT_API_KEY=
DAT_CLIENT_ID=
DAT_CLIENT_SECRET=

# Truckstop — NOT CONNECTED in Phase 5B (architecture stub only)
TRUCKSTOP_MARKET_RATES_ENABLED=false
TRUCKSTOP_API_BASE_URL=
# PENDING OFFICIAL API DOCUMENTATION — exact auth fields may differ
TRUCKSTOP_API_KEY=
TRUCKSTOP_CLIENT_ID=
TRUCKSTOP_CLIENT_SECRET=

# =============================================================================
# CarrierView GPS tracking (backend only — never expose token to frontend)
# =============================================================================
CARRIER_VIEW_ENABLED=false
CARRIER_VIEW_API_BASE_URL=
CARRIER_VIEW_API_TOKEN=
# Optional Green OS-side protection for webhook URLs (CarrierView docs do not define HMAC).
# Register: {PUBLIC_APP_URL}/api/integrations/carrier-view/webhooks/{type}?k=SECRET
CARRIER_VIEW_WEBHOOK_SECRET=
CARRIER_VIEW_RECONCILIATION_INTERVAL_SECONDS=300
