generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  roleId      String   @id @default(uuid()) @map("role_id")
  roleName    String   @unique @map("role_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

model User {
  userId                 String                 @id @default(uuid()) @map("user_id")
  username               String                 @unique
  passwordHash           String                 @map("password_hash")
  firstName              String                 @map("first_name")
  lastName               String                 @map("last_name")
  email                  String?                @unique
  roleId                 String                 @map("role_id")
  isActive               Boolean                @default(true) @map("is_active")
  availableForAssignment Boolean                @default(true) @map("available_for_assignment")
  employeeId             String?                @unique @map("employee_id")
  /** Broker → Team Lead (e.g. all brokers report to Gary Michael). */
  teamLeadId             String?                @map("team_lead_id")
  lastLogin              DateTime?              @map("last_login")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  role                   Role                   @relation(fields: [roleId], references: [roleId])
  employee               Employee?              @relation(fields: [employeeId], references: [employeeId])
  teamLead               User?                  @relation("TeamBrokers", fields: [teamLeadId], references: [userId])
  teamBrokers            User[]                 @relation("TeamBrokers")
  auditLogs              AuditLog[]
  brokerGmailAccount     BrokerGmailAccount?
  brokerMailboxMessages  BrokerMailboxMessage[]
  platformNotifications  PlatformNotification[]
  assignedCarriers       Carrier[]              @relation("CarrierAssignedBroker")
  directCustomers        DirectCustomer[]
  aiRuns                 AiRun[]
  aiDocumentJobs         AiDocumentJob[]
  aiActions              AiAction[]

  @@index([teamLeadId])
  @@map("users")
}

model Shift {
  shiftId            String              @id @default(uuid()) @map("shift_id")
  shiftName          String              @unique @map("shift_name")
  startTime          String              @map("start_time")
  endTime            String              @map("end_time")
  gracePeriodMinutes Int                 @default(15) @map("grace_period_minutes")
  crossMidnight      Boolean             @default(false) @map("cross_midnight")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  employees          Employee[]
  attendanceSessions AttendanceSession[]

  @@map("shifts")
}

model Employee {
  employeeId         String              @id @default(uuid()) @map("employee_id")
  employeeNumber     String              @unique @map("employee_number")
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  department         String?
  position           String?
  cardNumber         String              @unique @map("card_number")
  externalRef        String?             @unique @map("external_ref")
  cardType           Int                 @default(2) @map("card_type")
  shiftId            String              @map("shift_id")
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  shift              Shift               @relation(fields: [shiftId], references: [shiftId])
  user               User?
  attendanceSessions AttendanceSession[]
  attendanceEvents   AttendanceEvent[]
  notifications      Notification[]
  brokerGmailAccount BrokerGmailAccount?

  @@index([cardNumber])
  @@index([shiftId])
  @@index([status])
  @@map("employees")
}

model AttendanceSession {
  sessionId           String            @id @default(uuid()) @map("session_id")
  employeeId          String            @map("employee_id")
  shiftId             String            @map("shift_id")
  workDate            String            @map("work_date")
  scheduledStart      DateTime          @map("scheduled_start")
  scheduledEnd        DateTime          @map("scheduled_end")
  firstEntry          DateTime?         @map("first_entry")
  lastExit            DateTime?         @map("last_exit")
  currentStatus       String            @default("SCHEDULED") @map("current_status")
  late                Boolean           @default(false)
  lateMinutes         Int               @default(0) @map("late_minutes")
  totalAbsenceMinutes Int               @default(0) @map("total_absence_minutes")
  exitCount           Int               @default(0) @map("exit_count")
  lastActivity        DateTime?         @map("last_activity")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  employee            Employee          @relation(fields: [employeeId], references: [employeeId])
  shift               Shift             @relation(fields: [shiftId], references: [shiftId])
  attendanceEvents    AttendanceEvent[]
  absenceIntervals    AbsenceInterval[]

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@index([currentStatus])
  @@map("attendance_sessions")
}

model AttendanceEvent {
  eventId    String            @id @default(uuid()) @map("event_id")
  sessionId  String            @map("session_id")
  employeeId String            @map("employee_id")
  eventTime  DateTime          @map("event_time")
  direction  String
  eventType  String            @default("NORMAL") @map("event_type")
  deviceId   String            @map("device_id")
  webhookId  String            @unique @map("webhook_id")
  source     String            @default("ACCESS_CONTROL")
  createdAt  DateTime          @default(now()) @map("created_at")
  session    AttendanceSession @relation(fields: [sessionId], references: [sessionId])
  employee   Employee          @relation(fields: [employeeId], references: [employeeId])
  exitFor    AbsenceInterval[] @relation("ExitEvent")
  returnFor  AbsenceInterval[] @relation("ReturnEvent")

  @@index([sessionId])
  @@index([employeeId])
  @@index([eventTime])
  @@map("attendance_events")
}

model AbsenceInterval {
  intervalId      String            @id @default(uuid()) @map("interval_id")
  sessionId       String            @map("session_id")
  exitEventId     String            @map("exit_event_id")
  returnEventId   String?           @map("return_event_id")
  startTime       DateTime          @map("start_time")
  endTime         DateTime?         @map("end_time")
  durationMinutes Int?              @map("duration_minutes")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  session         AttendanceSession @relation(fields: [sessionId], references: [sessionId])
  exitEvent       AttendanceEvent   @relation("ExitEvent", fields: [exitEventId], references: [eventId])
  returnEvent     AttendanceEvent?  @relation("ReturnEvent", fields: [returnEventId], references: [eventId])

  @@index([sessionId])
  @@map("absence_intervals")
}

model Notification {
  notificationId   String    @id @default(uuid()) @map("notification_id")
  employeeId       String?   @map("employee_id")
  notificationType String    @map("notification_type")
  priority         String
  status           String    @default("UNREAD")
  message          String
  createdAt        DateTime  @default(now()) @map("created_at")
  employee         Employee? @relation(fields: [employeeId], references: [employeeId])

  @@index([status])
  @@map("notifications")
}

model AuditLog {
  auditId    String   @id @default(uuid()) @map("audit_id")
  userId     String   @map("user_id")
  module     String
  action     String
  entityName String   @map("entity_name")
  entityId   String?  @map("entity_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [userId])

  @@index([createdAt])
  @@map("audit_logs")
}

model WebhookLog {
  logId              String   @id @default(uuid()) @map("log_id")
  webhookId          String   @map("webhook_id")
  requestTime        DateTime @default(now()) @map("request_time")
  employeeIdentifier String?  @map("employee_identifier")
  requestPayload     String   @map("request_payload")
  responseCode       Int      @map("response_code")
  processingStatus   String   @map("processing_status")
  processingTimeMs   Int      @default(0) @map("processing_time_ms")
  errorMessage       String?  @map("error_message")

  @@index([webhookId])
  @@index([processingStatus])
  @@map("webhook_logs")
}

model Setting {
  settingId    String   @id @default(uuid()) @map("setting_id")
  category     String
  settingKey   String   @map("setting_key")
  settingValue String   @map("setting_value")
  description  String?
  updatedBy    String?  @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([category, settingKey])
  @@map("settings")
}

model PendingCardScan {
  scanId     String   @id @default(uuid()) @map("scan_id")
  cardToken  String   @unique @map("card_token")
  deviceId   String?  @map("device_id")
  scannedAt  DateTime @map("scanned_at")
  registered Boolean  @default(false) @map("registered")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([registered])
  @@map("pending_card_scans")
}

model PendingRegistration {
  pendingId            String    @id @default(uuid()) @map("pending_id")
  username             String
  passwordHash         String    @map("password_hash")
  firstName            String    @map("first_name")
  lastName             String    @map("last_name")
  email                String
  requestedRole        String    @map("requested_role")
  /** For Broker signups: which Team Lead (Gary / Alen) will own this broker. */
  requestedTeamLeadId  String?   @map("requested_team_lead_id")
  status               String    @default("PENDING")
  decidedAt            DateTime? @map("decided_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([username])
  @@map("pending_registrations")
}

model EmailMessage {
  emailMessageId String              @id @default(uuid()) @map("email_message_id")
  gmailMessageId String              @unique @map("gmail_message_id")
  gmailThreadId  String?             @map("gmail_thread_id")
  fromAddress    String              @map("from_address")
  subject        String
  snippet        String?
  receivedAt     DateTime            @map("received_at")
  processedAt    DateTime?           @map("processed_at")
  processStatus  String              @default("PENDING") @map("process_status")
  source         String?
  rawHeaders     String?             @map("raw_headers")
  bodyText       String?             @map("body_text")
  bodyHtml       String?             @map("body_html")
  createdAt      DateTime            @default(now()) @map("created_at")
  shipmentLeads  ShipmentLead[]
  importLogs     ShipmentImportLog[]

  @@index([processStatus])
  @@index([fromAddress])
  @@index([receivedAt])
  @@map("email_messages")
}

/// Shipment Aggregate Root (table name kept for compatibility).
/// One permanent card: Accept + Load Number NEVER creates a second record.
model ShipmentLead {
  shipmentLeadId        String                  @id @default(uuid()) @map("shipment_lead_id")
  /// Permanent human-readable Green OS Shipment ID (never changes).
  greenOsShipmentId     String?                 @unique @map("green_os_shipment_id")
  source                String
  externalShipmentId    String?                 @map("external_shipment_id")
  shipmentTitle         String                  @map("shipment_title")
  customerName          String?                 @map("customer_name")
  /// Customer contact email (for Rate Con / BOL / send).
  customerEmail         String?                 @map("customer_email")
  /// Customer phone (My Customers + docs).
  customerPhone         String?                 @map("customer_phone")
  pickupCity            String?                 @map("pickup_city")
  pickupState           String?                 @map("pickup_state")
  pickupZip             String?                 @map("pickup_zip")
  deliveryCity          String?                 @map("delivery_city")
  deliveryState         String?                 @map("delivery_state")
  deliveryZip           String?                 @map("delivery_zip")
  pickupFrom            DateTime?               @map("pickup_from")
  pickupTo              DateTime?               @map("pickup_to")
  deliveryFrom          DateTime?               @map("delivery_from")
  deliveryTo            DateTime?               @map("delivery_to")
  miles                 Float?
  category              String?
  equipment             String?
  vehicle               String?
  weight                String?
  price                 Float?
  priority              String                  @default("NORMAL")
  notes                 String?
  documentsJson         String?                 @map("documents_json")
  imageUrl              String?                 @map("image_url")
  viewUrl               String?                 @unique @map("view_url")
  status                String                  @default("NEW")
  /// Load Number extends THIS card — never a separate Load entity. Format: GL100001…
  loadNumber            String?                 @map("load_number")
  /// Customer / broker reference (PRO, PO, etc.) — not the Load Number.
  referenceNumber       String?                 @map("reference_number")
  commodity             String?
  pieces                Int?
  /// Sprint G — Operations fields (same card, no new entity).
  carrierName           String?                 @map("carrier_name")
  /// Carrier dispatch / ops email (for Rate Con / BOL / send).
  carrierEmail          String?                 @map("carrier_email")
  /// Carrier dispatch / ops cell phone.
  carrierPhone          String?                 @map("carrier_phone")
  carrierMc             String?                 @map("carrier_mc")
  carrierDot            String?                 @map("carrier_dot")
  carrierInsurance      String?                 @map("carrier_insurance")
  carrierStatus         String?                 @map("carrier_status")
  assignedDispatcherId  String?                 @map("assigned_dispatcher_id")
  driverName            String?                 @map("driver_name")
  /// Driver mobile for GPS tracking (CarrierView carrier_view integration).
  driverPhone           String?                 @map("driver_phone")
  truckNumber           String?                 @map("truck_number")
  trailerNumber         String?                 @map("trailer_number")
  rateConfirmation      String?                 @map("rate_confirmation")
  podUrl                String?                 @map("pod_url")
  invoiceNumber         String?                 @map("invoice_number")
  paymentStatus         String?                 @map("payment_status")
  /// Accounting confirms money received from customer.
  customerPaidAt        DateTime?               @map("customer_paid_at")
  customerPaidById      String?                 @map("customer_paid_by_id")
  /// Accounting confirms carrier / factoring company was paid.
  carrierPaidAt         DateTime?               @map("carrier_paid_at")
  carrierPaidById       String?                 @map("carrier_paid_by_id")
  /// Thank-you / review link emails sent by the broker before Close Load.
  reviewCustomerSentAt  DateTime?               @map("review_customer_sent_at")
  reviewCustomerSentTo  String?                 @map("review_customer_sent_to")
  reviewCarrierSentAt   DateTime?               @map("review_carrier_sent_at")
  reviewCarrierSentTo   String?                 @map("review_carrier_sent_to")
  reviewSentById        String?                 @map("review_sent_by_id")
  /// Pricing (broker never hand-calculates profit — derived in API).
  customerRate          Float?                  @map("customer_rate")
  carrierRate           Float?                  @map("carrier_rate")
  fuelSurcharge         Float?                  @map("fuel_surcharge")
  accessorialCharges    Float?                  @map("accessorial_charges")
  factoringFee          Float?                  @map("factoring_fee")
  trackingStatus        String?                 @map("tracking_status")
  invoiceDate           DateTime?               @map("invoice_date")
  invoiceDueDate        DateTime?               @map("invoice_due_date")
  paymentDate           DateTime?               @map("payment_date")
  customerNotes         String?                 @map("customer_notes")
  carrierNotes          String?                 @map("carrier_notes")
  aiNotes               String?                 @map("ai_notes")
  pinnedNotesJson       String?                 @map("pinned_notes_json")
  specialInstructions   String?                 @map("special_instructions")
  documentEditorJson    String?                 @map("document_editor_json")
  opsPickupAt           DateTime?               @map("ops_pickup_at")
  opsDeliveryAt         DateTime?               @map("ops_delivery_at")
  assignedBrokerId      String?                 @map("assigned_broker_id")
  /// Optional link to a Direct Customer (manual lots, not uShip).
  directCustomerId      String?                 @map("direct_customer_id")
  /// Optional link to master Carrier profile (onboarding / compliance).
  carrierProfileId      String?                 @map("carrier_profile_id")
  assignedAt            DateTime?               @map("assigned_at")
  acceptedAt            DateTime?               @map("accepted_at")
  acceptanceDeadline    DateTime?               @map("acceptance_deadline")
  quoteSentAt           DateTime?               @map("quote_sent_at")
  closedAt              DateTime?               @map("closed_at")
  emailMessageId        String?                 @map("email_message_id")
  receivedAt            DateTime?               @map("received_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  emailMessage          EmailMessage?           @relation(fields: [emailMessageId], references: [emailMessageId])
  importLogs            ShipmentImportLog[]
  timelineEvents        ShipmentTimelineEvent[]
  domainEvents          DomainEvent[]
  platformNotifications PlatformNotification[]
  brokerMailboxMessages BrokerMailboxMessage[]
  loadDocuments         LoadDocument[]
  shipmentTrackings     ShipmentTracking[]
  carrierProfile        Carrier?                @relation(fields: [carrierProfileId], references: [carrierId], onDelete: SetNull)
  directCustomer        DirectCustomer?         @relation(fields: [directCustomerId], references: [customerId], onDelete: SetNull)

  @@index([source])
  @@index([status])
  @@index([externalShipmentId])
  @@index([assignedBrokerId])
  @@index([directCustomerId])
  @@index([carrierProfileId])
  @@index([priority])
  @@index([createdAt])
  @@index([loadNumber])
  @@map("shipment_leads")
}

/// GPS / ELD tracking session for a Load (provider-agnostic).
/// CarrierView load.id → providerLoadId (required for all CarrierView load APIs).
model ShipmentTracking {
  trackingId              String             @id @default(uuid()) @map("tracking_id")
  shipmentLeadId          String             @map("shipment_lead_id")
  /// carrier_view | motive | samsara | verizon
  provider                String             @map("provider")
  /// Provider's load id (CarrierView: data.id). Never lose this.
  providerLoadId          String             @map("provider_load_id")
  /// Our reference sent as CarrierView load_id (usually GL#).
  externalLoadRef         String?            @map("external_load_ref")
  /// ACTIVE | DISABLED | DELETED | ERROR
  status                  String             @default("ACTIVE")
  driverPhone             String?            @map("driver_phone")
  trackingUrl             String?            @map("tracking_url")
  clientTrackingUrl       String?            @map("client_tracking_url")
  lastLatitude            Float?             @map("last_latitude")
  lastLongitude           Float?             @map("last_longitude")
  lastAddress             String?            @map("last_address")
  lastPositionAt          DateTime?          @map("last_position_at")
  movementType            String?            @map("movement_type")
  rotation                Float?
  driverAppStatus         String?            @map("driver_app_status")
  routeStarted            Boolean            @default(false) @map("route_started")
  driverIsLate            Boolean            @default(false) @map("driver_is_late")
  timeLeftSec             Int?               @map("time_left_sec")
  distanceLeftMeters      Float?             @map("distance_left_meters")
  pickupArrivedAt         DateTime?          @map("pickup_arrived_at")
  pickupDepartedAt        DateTime?          @map("pickup_departed_at")
  destinationArrivedAt    DateTime?          @map("destination_arrived_at")
  destinationDepartedAt   DateTime?          @map("destination_departed_at")
  providerLocationsJson   String?            @map("provider_locations_json")
  providerStatusesJson     String?            @map("provider_statuses_json")
  providerMetaJson        String?            @map("provider_meta_json")
  lastError               String?            @map("last_error")
  lastSyncedAt            DateTime?          @map("last_synced_at")
  disabledAt              DateTime?          @map("disabled_at")
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  shipmentLead            ShipmentLead       @relation(fields: [shipmentLeadId], references: [shipmentLeadId], onDelete: Cascade)
  positions               TrackingPosition[]
  integrationEvents       TrackingIntegrationEvent[]

  @@unique([provider, providerLoadId])
  @@index([shipmentLeadId])
  @@index([provider])
  @@index([status])
  @@index([driverPhone])
  @@map("shipment_trackings")
}

/// Append-only GPS breadcrumbs (never overwrite).
model TrackingPosition {
  positionId         String           @id @default(uuid()) @map("position_id")
  trackingId         String           @map("tracking_id")
  shipmentLeadId     String           @map("shipment_lead_id")
  provider           String
  providerLoadId     String           @map("provider_load_id")
  driverPhone        String?          @map("driver_phone")
  latitude           Float
  longitude          Float
  address            String?
  movementType       String?          @map("movement_type")
  rotation           Float?
  lateSeconds        Int?             @map("late_seconds")
  stoppedDuration    Int?             @map("stopped_duration")
  driveDuration      Int?             @map("drive_duration")
  pausedDuration     Int?             @map("paused_duration")
  providerTimestamp  DateTime?        @map("provider_timestamp")
  receivedAt         DateTime         @default(now()) @map("received_at")
  /// Deterministic fingerprint to prevent duplicate inserts.
  fingerprint        String           @map("fingerprint")
  tracking           ShipmentTracking @relation(fields: [trackingId], references: [trackingId], onDelete: Cascade)

  @@unique([trackingId, fingerprint])
  @@index([shipmentLeadId])
  @@index([providerLoadId])
  @@index([receivedAt])
  @@map("tracking_positions")
}

/// Idempotent audit of tracking API calls + webhooks.
model TrackingIntegrationEvent {
  eventId            String            @id @default(uuid()) @map("event_id")
  trackingId         String?           @map("tracking_id")
  shipmentLeadId     String?           @map("shipment_lead_id")
  provider           String
  eventType          String            @map("event_type")
  providerLoadId     String?           @map("provider_load_id")
  payloadHash        String            @map("payload_hash")
  processingStatus   String            @default("RECEIVED") @map("processing_status")
  errorMessage       String?           @map("error_message")
  /// Redacted JSON — never store API tokens.
  rawPayloadJson     String?           @map("raw_payload_json")
  receivedAt         DateTime          @default(now()) @map("received_at")
  processedAt        DateTime?         @map("processed_at")
  tracking           ShipmentTracking? @relation(fields: [trackingId], references: [trackingId], onDelete: SetNull)

  @@unique([provider, eventType, payloadHash])
  @@index([shipmentLeadId])
  @@index([providerLoadId])
  @@index([receivedAt])
  @@map("tracking_integration_events")
}

/// Versioned documents that belong ONLY to a Load (ShipmentLead with loadNumber).
/// Never overwrite: each edit creates a new version row.
model LoadDocument {
  documentId     String       @id @default(uuid()) @map("document_id")
  shipmentLeadId String       @map("shipment_lead_id")
  /// RATE_CONFIRMATION | BOL | POD | CARRIER_PACKET | INSURANCE | W9 | NOA | CUSTOMER_INVOICE | CARRIER_INVOICE | DISPATCH_SHEET | LOAD_SUMMARY | ATTACHMENT
  docType        String       @map("doc_type")
  version        Int          @default(1)
  /// GENERATED | BROKER_EDITED | CUSTOMER_REQUESTED | FINAL_SIGNED | UPLOADED | REPLACED | ARCHIVED
  changeReason   String       @default("GENERATED") @map("change_reason")
  title          String
  status         String       @default("DRAFT") // DRAFT | READY | SENT | SIGNED | ARCHIVED
  isCurrent      Boolean      @default(true) @map("is_current")
  /// Editable field snapshot used to regenerate PDF (never lose prior versions).
  contentJson    String?      @map("content_json")
  fileName       String?      @map("file_name")
  mimeType       String?      @map("mime_type")
  storedName     String?      @map("stored_name")
  fileUrl        String?      @map("file_url")
  fileSize       Int?         @map("file_size")
  createdById    String?      @map("created_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  shipmentLead   ShipmentLead @relation(fields: [shipmentLeadId], references: [shipmentLeadId], onDelete: Cascade)

  @@unique([shipmentLeadId, docType, version])
  @@index([shipmentLeadId])
  @@index([docType])
  @@index([isCurrent])
  @@map("load_documents")
}

/// Append-only Domain Events — source of truth for Timeline, Notifications, CRM, Analytics.
model DomainEvent {
  eventId        String        @id @default(uuid()) @map("event_id")
  shipmentLeadId String?       @map("shipment_lead_id")
  eventType      String        @map("event_type")
  title          String
  message        String?
  actorUserId    String?       @map("actor_user_id")
  payloadJson    String?       @map("payload_json")
  createdAt      DateTime      @default(now()) @map("created_at")
  shipmentLead   ShipmentLead? @relation(fields: [shipmentLeadId], references: [shipmentLeadId], onDelete: Cascade)

  @@index([shipmentLeadId])
  @@index([eventType])
  @@index([createdAt])
  @@map("domain_events")
}

model ShipmentTimelineEvent {
  eventId        String       @id @default(uuid()) @map("event_id")
  shipmentLeadId String       @map("shipment_lead_id")
  stage          String
  title          String
  message        String?
  actorUserId    String?      @map("actor_user_id")
  metaJson       String?      @map("meta_json")
  createdAt      DateTime     @default(now()) @map("created_at")
  shipmentLead   ShipmentLead @relation(fields: [shipmentLeadId], references: [shipmentLeadId], onDelete: Cascade)

  @@index([shipmentLeadId])
  @@index([stage])
  @@index([createdAt])
  @@map("shipment_timeline_events")
}

model ShipmentImportLog {
  logId          String        @id @default(uuid()) @map("log_id")
  eventType      String        @map("event_type")
  message        String
  gmailMessageId String?       @map("gmail_message_id")
  emailMessageId String?       @map("email_message_id")
  shipmentLeadId String?       @map("shipment_lead_id")
  metaJson       String?       @map("meta_json")
  createdAt      DateTime      @default(now()) @map("created_at")
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [emailMessageId])
  shipmentLead   ShipmentLead? @relation(fields: [shipmentLeadId], references: [shipmentLeadId])

  @@index([eventType])
  @@index([createdAt])
  @@map("shipment_import_logs")
}

model AssignmentQueueState {
  queueKey           String   @id @default("brokers") @map("queue_key")
  orderedUserIdsJson String   @default("[]") @map("ordered_user_ids_json")
  nextIndex          Int      @default(0) @map("next_index")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("assignment_queue_state")
}

model AssignmentLog {
  logId              String   @id @default(uuid()) @map("log_id")
  shipmentLeadId     String?  @map("shipment_lead_id")
  assignedUserId     String?  @map("assigned_user_id")
  assignedEmployeeId String?  @map("assigned_employee_id")
  eventType          String   @map("event_type")
  message            String
  queueSnapshotJson  String?  @map("queue_snapshot_json")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([shipmentLeadId])
  @@index([assignedUserId])
  @@index([eventType])
  @@index([createdAt])
  @@map("assignment_logs")
}

/// Sprint C — each broker connects their own Gmail (uShip sync only).
model BrokerGmailAccount {
  brokerGmailId String                 @id @default(uuid()) @map("broker_gmail_id")
  brokerId      String?                @unique @map("broker_id")
  userId        String                 @unique @map("user_id")
  gmailAddress  String                 @map("gmail_address")
  googleUserId  String?                @map("google_user_id")
  refreshToken  String                 @map("refresh_token")
  historyId     String?                @map("history_id")
  status        String                 @default("CONNECTED")
  connectedAt   DateTime               @default(now()) @map("connected_at")
  lastSyncAt    DateTime?              @map("last_sync_at")
  lastError     String?                @map("last_error")
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  broker        Employee?              @relation(fields: [brokerId], references: [employeeId], onDelete: Cascade)
  user          User                   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  messages      BrokerMailboxMessage[]

  @@index([status])
  @@index([gmailAddress])
  @@index([isActive])
  @@map("broker_gmail_accounts")
}

/// uShip-related emails from a broker mailbox (history). Personal mail is never stored.
model BrokerMailboxMessage {
  messageId      String             @id @default(uuid()) @map("message_id")
  userId         String             @map("user_id")
  brokerGmailId  String             @map("broker_gmail_id")
  gmailMessageId String             @map("gmail_message_id")
  gmailThreadId  String?            @map("gmail_thread_id")
  shipmentLeadId String?            @map("shipment_lead_id")
  fromAddress    String             @map("from_address")
  subject        String
  snippet        String?
  bodyText       String?            @map("body_text")
  receivedAt     DateTime           @map("received_at")
  matchMethod    String?            @map("match_method")
  createdAt      DateTime           @default(now()) @map("created_at")
  user           User               @relation(fields: [userId], references: [userId], onDelete: Cascade)
  brokerGmail    BrokerGmailAccount @relation(fields: [brokerGmailId], references: [brokerGmailId], onDelete: Cascade)
  shipmentLead   ShipmentLead?      @relation(fields: [shipmentLeadId], references: [shipmentLeadId], onDelete: SetNull)

  @@unique([userId, gmailMessageId])
  @@index([shipmentLeadId])
  @@index([receivedAt])
  @@index([brokerGmailId])
  @@map("broker_mailbox_messages")
}

/// Sprint F — GreenOS Notification Center (not Gmail).
model PlatformNotification {
  notificationId   String        @id @default(uuid()) @map("notification_id")
  userId           String?       @map("user_id")
  roleAudience     String?       @map("role_audience")
  shipmentLeadId   String?       @map("shipment_lead_id")
  notificationType String        @map("notification_type")
  title            String
  message          String
  status           String        @default("UNREAD")
  metaJson         String?       @map("meta_json")
  createdAt        DateTime      @default(now()) @map("created_at")
  readAt           DateTime?     @map("read_at")
  user             User?         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  shipmentLead     ShipmentLead? @relation(fields: [shipmentLeadId], references: [shipmentLeadId], onDelete: Cascade)

  @@index([userId, status])
  @@index([shipmentLeadId])
  @@index([createdAt])
  @@index([notificationType])
  @@map("platform_notifications")
}

/// Direct (non-uShip) customers — broker address book + Create Load.
model DirectCustomer {
  customerId        String         @id @default(uuid()) @map("customer_id")
  companyName       String         @map("company_name")
  contactName       String?        @map("contact_name")
  email             String?
  phone             String?
  billingAddress    String?        @map("billing_address")
  city              String?
  state             String?
  zip               String?
  notes             String?
  createdByUserId   String         @map("created_by_user_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  createdBy         User           @relation(fields: [createdByUserId], references: [userId], onDelete: Restrict)
  shipments         ShipmentLead[]

  @@index([createdByUserId])
  @@index([companyName])
  @@map("direct_customers")
}

/// Master Carrier profile — Green OS is system of record (not Gmail).
model Carrier {
  carrierId         String                      @id @default(uuid()) @map("carrier_id")
  legalName         String                      @map("legal_name")
  dbaName           String?                     @map("dba_name")
  email             String
  phone             String?
  mcNumber          String?                     @map("mc_number")
  dotNumber         String?                     @map("dot_number")
  address           String?
  city              String?
  state             String?
  zip               String?
  contactName       String?                     @map("contact_name")
  fax               String?
  federalTaxId      String?                     @map("federal_tax_id")
  equipmentNotes    String?                     @map("equipment_notes")
  paymentOption     String?                     @map("payment_option")
  /// ACTIVE | INACTIVE | BLOCKED
  status            String                      @default("ACTIVE")
  /// INVITED | OPENED | IN_PROGRESS | SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | EXPIRED | REQUEST_CHANGES
  onboardingStatus  String                      @default("INVITED") @map("onboarding_status")
  assignedBrokerId  String?                     @map("assigned_broker_id")
  notes             String?
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  assignedBroker    User?                       @relation("CarrierAssignedBroker", fields: [assignedBrokerId], references: [userId], onDelete: SetNull)
  sessions          CarrierOnboardingSession[]
  documents         CarrierDocument[]
  agreementSigns    CarrierAgreementSignature[]
  rcSignatures      CarrierRcSignature[]
  events            CarrierOnboardingEvent[]
  shipments         ShipmentLead[]

  @@index([email])
  @@index([mcNumber])
  @@index([dotNumber])
  @@index([assignedBrokerId])
  @@index([onboardingStatus])
  @@index([status])
  @@index([createdAt])
  @@map("carriers")
}

model CarrierOnboardingSession {
  sessionId       String                 @id @default(uuid()) @map("session_id")
  carrierId       String                 @map("carrier_id")
  /// SHA-256 of raw token — never store the raw token.
  tokenHash       String                 @unique @map("token_hash")
  expiresAt       DateTime               @map("expires_at")
  usedAt          DateTime?              @map("used_at")
  openedAt        DateTime?              @map("opened_at")
  submittedAt     DateTime?              @map("submitted_at")
  /// ACTIVE | SUBMITTED | EXPIRED | REVOKED
  status          String                 @default("ACTIVE")
  /// AGREEMENT_PACKET (after Assign Carrier) | RC_BOL_PACKET (after BOL save)
  purpose         String                 @default("AGREEMENT_PACKET")
  createdById     String?                @map("created_by_id")
  /// Optional shipment for pre-filled Rate Confirmation.
  shipmentLeadId  String?                @map("shipment_lead_id")
  progressJson    String?                @map("progress_json")
  changeRequestNote String?              @map("change_request_note")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  carrier         Carrier                @relation(fields: [carrierId], references: [carrierId], onDelete: Cascade)

  @@index([carrierId])
  @@index([status])
  @@index([expiresAt])
  @@index([shipmentLeadId])
  @@map("carrier_onboarding_sessions")
}

model CarrierDocument {
  documentId       String    @id @default(uuid()) @map("document_id")
  carrierId        String    @map("carrier_id")
  shipmentLeadId   String?   @map("shipment_lead_id")
  /// MC_AUTHORITY | NOA | W9 | INSURANCE | COI | BROKER_CARRIER_AGREEMENT | RATE_CONFIRMATION | OTHER
  documentType     String    @map("document_type")
  originalFilename String    @map("original_filename")
  storageKey       String    @map("storage_key")
  mimeType         String    @map("mime_type")
  fileSize         Int       @map("file_size")
  checksum         String?
  uploadedBy       String    @default("CARRIER") @map("uploaded_by")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  /// CURRENT | ARCHIVED
  status           String    @default("CURRENT")
  version          Int       @default(1)
  carrier          Carrier   @relation(fields: [carrierId], references: [carrierId], onDelete: Cascade)

  @@index([carrierId])
  @@index([documentType])
  @@index([status])
  @@index([shipmentLeadId])
  @@map("carrier_documents")
}

model CarrierAgreementTemplate {
  templateId  String                      @id @default(uuid()) @map("template_id")
  title       String
  version     String
  bodyText    String                      @map("body_text")
  fileRef     String?                     @map("file_ref")
  active      Boolean                     @default(true)
  createdAt   DateTime                    @default(now()) @map("created_at")
  signatures  CarrierAgreementSignature[]

  @@index([active])
  @@map("carrier_agreement_templates")
}

model CarrierAgreementSignature {
  signatureId  String                   @id @default(uuid()) @map("signature_id")
  carrierId    String                   @map("carrier_id")
  templateId   String                   @map("template_id")
  sessionId    String?                  @map("session_id")
  signerName   String                   @map("signer_name")
  signerEmail  String                   @map("signer_email")
  /// Drawn/typed signature payload (audit trail — not claimed as legal e-sign alone).
  signatureData String                  @map("signature_data")
  agreed       Boolean                  @default(true)
  signedAt     DateTime                 @default(now()) @map("signed_at")
  ipAddress    String?                  @map("ip_address")
  userAgent    String?                  @map("user_agent")
  documentHash String?                  @map("document_hash")
  carrier      Carrier                  @relation(fields: [carrierId], references: [carrierId], onDelete: Cascade)
  template     CarrierAgreementTemplate @relation(fields: [templateId], references: [templateId], onDelete: Restrict)

  @@index([carrierId])
  @@index([templateId])
  @@index([sessionId])
  @@map("carrier_agreement_signatures")
}

model CarrierRcSignature {
  rcSignatureId   String   @id @default(uuid()) @map("rc_signature_id")
  carrierId       String   @map("carrier_id")
  sessionId       String?  @map("session_id")
  shipmentLeadId  String?  @map("shipment_lead_id")
  contentJson     String   @map("content_json")
  signerName      String   @map("signer_name")
  signerEmail     String   @map("signer_email")
  signatureData   String   @map("signature_data")
  signedAt        DateTime @default(now()) @map("signed_at")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  documentHash    String?  @map("document_hash")
  carrier         Carrier  @relation(fields: [carrierId], references: [carrierId], onDelete: Cascade)

  @@index([carrierId])
  @@index([sessionId])
  @@index([shipmentLeadId])
  @@map("carrier_rc_signatures")
}

/// Immutable-style onboarding timeline (append-only).
model CarrierOnboardingEvent {
  eventId     String   @id @default(uuid()) @map("event_id")
  carrierId   String   @map("carrier_id")
  sessionId   String?  @map("session_id")
  shipmentLeadId String? @map("shipment_lead_id")
  action      String
  title       String
  message     String?
  actorType   String   @default("SYSTEM") @map("actor_type")
  actorId     String?  @map("actor_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  metadataJson String? @map("metadata_json")
  createdAt   DateTime @default(now()) @map("created_at")
  carrier     Carrier  @relation(fields: [carrierId], references: [carrierId], onDelete: Cascade)

  @@index([carrierId])
  @@index([action])
  @@index([createdAt])
  @@map("carrier_onboarding_events")
}

/// Phase 1 GreenOS AI — one row per /api/ai/chat request (no secrets).
model AiRun {
  runId            String    @id @default(uuid()) @map("run_id")
  actorUserId      String    @map("actor_user_id")
  model            String
  /// Truncated user message (never secrets / API keys).
  requestPreview   String    @map("request_preview")
  intent           String?
  answerMode       String?   @map("answer_mode")
  /// JSON array of tool names invoked.
  toolsJson        String?   @map("tools_json")
  /// JSON array of sources (entity ids only).
  sourcesJson      String?   @map("sources_json")
  promptTokens     Int?      @map("prompt_tokens")
  completionTokens Int?      @map("completion_tokens")
  totalTokens      Int?      @map("total_tokens")
  estimatedCostUsd Float?    @map("estimated_cost_usd")
  /// PENDING | SUCCESS | ERROR | RATE_LIMITED
  status           String    @default("PENDING")
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at")
  completedAt      DateTime? @map("completed_at")
  actor            User      @relation(fields: [actorUserId], references: [userId], onDelete: Cascade)

  @@index([actorUserId])
  @@index([createdAt])
  @@index([status])
  @@map("ai_runs")
}

/// Phase 2B — Document AI processing job (async; non-blocking HTTP).
model AiDocumentJob {
  jobId             String    @id @default(uuid()) @map("job_id")
  /// CARRIER | LOAD
  documentSource    String    @map("document_source")
  documentId        String    @map("document_id")
  carrierId         String?   @map("carrier_id")
  shipmentLeadId    String?   @map("shipment_lead_id")
  actorUserId       String    @map("actor_user_id")
  checksum          String
  /// Declared GreenOS doc type at upload time (may differ from classified).
  declaredDocType   String?   @map("declared_doc_type")
  classifiedDocType String?   @map("classified_doc_type")
  /// QUEUED | PROCESSING | SUCCEEDED | FAILED | CACHED
  status            String    @default("QUEUED")
  attempts          Int       @default(0)
  errorMessage      String?   @map("error_message")
  providerModel     String?   @map("provider_model")
  /// Prior successful job reused via checksum cache.
  cachedFromJobId   String?   @map("cached_from_job_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  startedAt         DateTime? @map("started_at")
  completedAt       DateTime? @map("completed_at")
  actor             User      @relation(fields: [actorUserId], references: [userId], onDelete: Cascade)
  extraction        AiDocumentExtraction?
  validation        DocumentValidationResult?

  @@index([documentId])
  @@index([checksum])
  @@index([status])
  @@index([actorUserId])
  @@index([createdAt])
  @@index([carrierId])
  @@index([shipmentLeadId])
  @@map("ai_document_jobs")
}

model AiDocumentExtraction {
  extractionId      String   @id @default(uuid()) @map("extraction_id")
  jobId             String   @unique @map("job_id")
  documentType      String   @map("document_type")
  pageCount         Int?     @map("page_count")
  textCharCount     Int?     @map("text_char_count")
  overallConfidence Float?   @map("overall_confidence")
  /// JSON: signature objects
  signaturesJson    String?  @map("signatures_json")
  /// JSON: boundary / multi-doc notes
  metaJson          String?  @map("meta_json")
  createdAt         DateTime @default(now()) @map("created_at")
  job               AiDocumentJob @relation(fields: [jobId], references: [jobId], onDelete: Cascade)
  fields            DocumentExtractionField[]

  @@index([documentType])
  @@map("ai_document_extractions")
}

model DocumentExtractionField {
  fieldId          String   @id @default(uuid()) @map("field_id")
  extractionId     String   @map("extraction_id")
  fieldKey         String   @map("field_key")
  /// Display value — never full SSN/EIN.
  valueText        String?  @map("value_text")
  valueNormalized  String?  @map("value_normalized")
  /// Optional protected hash/token for sensitive match (not plaintext TIN).
  valueProtected   String?  @map("value_protected")
  confidence       Float?
  page             Int?
  source           String?
  method           String?
  /// FIELD_FOUND | FIELD_MISSING | FIELD_UNCERTAIN | FIELD_MATCH | FIELD_MISMATCH | BELOW_REQUIREMENT | EXPIRED
  fieldStatus      String   @default("FIELD_FOUND") @map("field_status")
  extraction       AiDocumentExtraction @relation(fields: [extractionId], references: [extractionId], onDelete: Cascade)

  @@index([extractionId])
  @@index([fieldKey])
  @@map("document_extraction_fields")
}

model DocumentValidationResult {
  validationId   String    @id @default(uuid()) @map("validation_id")
  jobId          String    @unique @map("job_id")
  /// VALID | REVIEW_REQUIRED | INVALID | MISMATCH | EXPIRED | UNSIGNED | ...
  overallStatus  String    @map("overall_status")
  /// GREEN | YELLOW | RED
  trafficLight   String    @map("traffic_light")
  levelsJson     String?   @map("levels_json")
  checksJson     String?   @map("checks_json")
  matchesJson    String?   @map("matches_json")
  warningsJson   String?   @map("warnings_json")
  errorsJson     String?   @map("errors_json")
  requiresReview Boolean   @default(false) @map("requires_review")
  reviewerUserId String?   @map("reviewer_user_id")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewDecision String?   @map("review_decision")
  reviewNotes    String?   @map("review_notes")
  createdAt      DateTime  @default(now()) @map("created_at")
  job            AiDocumentJob @relation(fields: [jobId], references: [jobId], onDelete: Cascade)

  @@index([overallStatus])
  @@index([requiresReview])
  @@map("document_validation_results")
}

/// Phase 6 — AI action proposal (propose → confirm → execute). Never auto-executed.
model AiAction {
  actionId         String    @id @default(uuid()) @map("action_id")
  actorUserId      String    @map("actor_user_id")
  /// SEND_EMAIL | CREATE_INTERNAL_NOTE | CREATE_FOLLOW_UP | REQUEST_DOCUMENT | MARK_REVIEW_REQUIRED
  actionType       String    @map("action_type")
  /// DRAFT | PENDING_CONFIRMATION | CONFIRMED | EXECUTING | EXECUTED | FAILED | CANCELLED | EXPIRED | ALREADY_EXECUTED
  status           String    @default("PENDING_CONFIRMATION")
  title            String
  description      String?
  reason           String?
  /// carrier | shipment | document_job | none
  targetType       String    @map("target_type")
  targetId         String?   @map("target_id")
  /// JSON payload (recipients, subject, body, note text, doc type, etc.) — validated again at confirm.
  payloadJson      String    @map("payload_json")
  /// JSON array of source refs (entity ids / labels only — no document bodies).
  sourcesJson      String?   @map("sources_json")
  aiRunId          String?   @map("ai_run_id")
  idempotencyKey   String    @unique @map("idempotency_key")
  /// SHA-256 of canonical payload at proposal time (detect client tampering).
  payloadHash      String    @map("payload_hash")
  /// Optional fingerprint of grounding state for stale-action detection.
  groundingHash    String?   @map("grounding_hash")
  expiresAt        DateTime  @map("expires_at")
  confirmedAt      DateTime? @map("confirmed_at")
  executedAt       DateTime? @map("executed_at")
  cancelledAt      DateTime? @map("cancelled_at")
  resultJson       String?   @map("result_json")
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  actor            User      @relation(fields: [actorUserId], references: [userId], onDelete: Cascade)

  @@index([actorUserId])
  @@index([status])
  @@index([actionType])
  @@index([targetType, targetId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("ai_actions")
}
