generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  roleId      String   @id @default(uuid()) @map("role_id")
  roleName    String   @unique @map("role_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

model User {
  userId                 String     @id @default(uuid()) @map("user_id")
  username               String     @unique
  passwordHash           String     @map("password_hash")
  firstName              String     @map("first_name")
  lastName               String     @map("last_name")
  email                  String?    @unique
  roleId                 String     @map("role_id")
  isActive               Boolean    @default(true) @map("is_active")
  availableForAssignment Boolean    @default(true) @map("available_for_assignment")
  employeeId             String?    @unique @map("employee_id")
  lastLogin              DateTime?  @map("last_login")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")
  role                   Role       @relation(fields: [roleId], references: [roleId])
  employee               Employee?  @relation(fields: [employeeId], references: [employeeId])
  auditLogs              AuditLog[]

  @@map("users")
}

model Shift {
  shiftId            String              @id @default(uuid()) @map("shift_id")
  shiftName          String              @unique @map("shift_name")
  startTime          String              @map("start_time")
  endTime            String              @map("end_time")
  gracePeriodMinutes Int                 @default(15) @map("grace_period_minutes")
  crossMidnight      Boolean             @default(false) @map("cross_midnight")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  employees          Employee[]
  attendanceSessions AttendanceSession[]

  @@map("shifts")
}

model Employee {
  employeeId         String              @id @default(uuid()) @map("employee_id")
  employeeNumber     String              @unique @map("employee_number")
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  department         String?
  position           String?
  cardNumber         String              @unique @map("card_number")
  externalRef        String?             @unique @map("external_ref")
  cardType           Int                 @default(2) @map("card_type")
  shiftId            String              @map("shift_id")
  status             String              @default("ACTIVE")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  shift              Shift               @relation(fields: [shiftId], references: [shiftId])
  user               User?
  attendanceSessions AttendanceSession[]
  attendanceEvents   AttendanceEvent[]
  notifications      Notification[]

  @@index([cardNumber])
  @@index([shiftId])
  @@index([status])
  @@map("employees")
}

model AttendanceSession {
  sessionId           String             @id @default(uuid()) @map("session_id")
  employeeId          String             @map("employee_id")
  shiftId             String             @map("shift_id")
  workDate            String             @map("work_date")
  scheduledStart      DateTime           @map("scheduled_start")
  scheduledEnd        DateTime           @map("scheduled_end")
  firstEntry          DateTime?          @map("first_entry")
  lastExit            DateTime?          @map("last_exit")
  currentStatus       String             @default("SCHEDULED") @map("current_status")
  late                Boolean            @default(false)
  lateMinutes         Int                @default(0) @map("late_minutes")
  totalAbsenceMinutes Int                @default(0) @map("total_absence_minutes")
  exitCount           Int                @default(0) @map("exit_count")
  lastActivity        DateTime?          @map("last_activity")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  employee            Employee           @relation(fields: [employeeId], references: [employeeId])
  shift               Shift              @relation(fields: [shiftId], references: [shiftId])
  attendanceEvents    AttendanceEvent[]
  absenceIntervals    AbsenceInterval[]

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@index([currentStatus])
  @@map("attendance_sessions")
}

model AttendanceEvent {
  eventId    String            @id @default(uuid()) @map("event_id")
  sessionId  String            @map("session_id")
  employeeId String            @map("employee_id")
  eventTime  DateTime          @map("event_time")
  direction  String
  eventType  String            @default("NORMAL") @map("event_type")
  deviceId   String            @map("device_id")
  webhookId  String            @unique @map("webhook_id")
  source     String            @default("ACCESS_CONTROL")
  createdAt  DateTime          @default(now()) @map("created_at")
  session    AttendanceSession @relation(fields: [sessionId], references: [sessionId])
  employee   Employee          @relation(fields: [employeeId], references: [employeeId])
  exitFor    AbsenceInterval[] @relation("ExitEvent")
  returnFor  AbsenceInterval[] @relation("ReturnEvent")

  @@index([sessionId])
  @@index([employeeId])
  @@index([eventTime])
  @@map("attendance_events")
}

model AbsenceInterval {
  intervalId      String            @id @default(uuid()) @map("interval_id")
  sessionId       String            @map("session_id")
  exitEventId     String            @map("exit_event_id")
  returnEventId   String?           @map("return_event_id")
  startTime       DateTime          @map("start_time")
  endTime         DateTime?         @map("end_time")
  durationMinutes Int?              @map("duration_minutes")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  session         AttendanceSession @relation(fields: [sessionId], references: [sessionId])
  exitEvent       AttendanceEvent   @relation("ExitEvent", fields: [exitEventId], references: [eventId])
  returnEvent     AttendanceEvent?  @relation("ReturnEvent", fields: [returnEventId], references: [eventId])

  @@index([sessionId])
  @@map("absence_intervals")
}

model Notification {
  notificationId   String    @id @default(uuid()) @map("notification_id")
  employeeId       String?   @map("employee_id")
  notificationType String    @map("notification_type")
  priority         String
  status           String    @default("UNREAD")
  message          String
  createdAt        DateTime  @default(now()) @map("created_at")
  employee         Employee? @relation(fields: [employeeId], references: [employeeId])

  @@index([status])
  @@map("notifications")
}

model AuditLog {
  auditId    String   @id @default(uuid()) @map("audit_id")
  userId     String   @map("user_id")
  module     String
  action     String
  entityName String   @map("entity_name")
  entityId   String?  @map("entity_id")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [userId])

  @@index([createdAt])
  @@map("audit_logs")
}

model WebhookLog {
  logId              String   @id @default(uuid()) @map("log_id")
  webhookId          String   @map("webhook_id")
  requestTime        DateTime @default(now()) @map("request_time")
  employeeIdentifier String?  @map("employee_identifier")
  requestPayload     String   @map("request_payload")
  responseCode       Int      @map("response_code")
  processingStatus   String   @map("processing_status")
  processingTimeMs   Int      @default(0) @map("processing_time_ms")
  errorMessage       String?  @map("error_message")

  @@index([webhookId])
  @@index([processingStatus])
  @@map("webhook_logs")
}

model Setting {
  settingId    String   @id @default(uuid()) @map("setting_id")
  category     String
  settingKey   String   @map("setting_key")
  settingValue String   @map("setting_value")
  description  String?
  updatedBy    String?  @map("updated_by")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([category, settingKey])
  @@map("settings")
}

model PendingCardScan {
  scanId     String   @id @default(uuid()) @map("scan_id")
  cardToken  String   @unique @map("card_token")
  deviceId   String?  @map("device_id")
  scannedAt  DateTime @map("scanned_at")
  registered Boolean  @default(false) @map("registered")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([registered])
  @@map("pending_card_scans")
}

model PendingRegistration {
  pendingId     String    @id @default(uuid()) @map("pending_id")
  username      String
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  email         String
  requestedRole String    @map("requested_role")
  status        String    @default("PENDING")
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([username])
  @@map("pending_registrations")
}

model EmailMessage {
  emailMessageId String   @id @default(uuid()) @map("email_message_id")
  gmailMessageId String   @unique @map("gmail_message_id")
  gmailThreadId  String?  @map("gmail_thread_id")
  fromAddress    String   @map("from_address")
  subject        String
  snippet        String?
  receivedAt     DateTime @map("received_at")
  processedAt    DateTime? @map("processed_at")
  processStatus  String   @default("PENDING") @map("process_status")
  source         String?
  rawHeaders     String?  @map("raw_headers")
  bodyText       String?  @map("body_text")
  bodyHtml       String?  @map("body_html")
  createdAt      DateTime @default(now()) @map("created_at")
  shipmentLeads  ShipmentLead[]
  importLogs     ShipmentImportLog[]

  @@index([processStatus])
  @@index([fromAddress])
  @@index([receivedAt])
  @@map("email_messages")
}

model ShipmentLead {
  shipmentLeadId     String   @id @default(uuid()) @map("shipment_lead_id")
  source             String
  externalShipmentId String?  @map("external_shipment_id")
  shipmentTitle      String   @map("shipment_title")
  customerName       String?  @map("customer_name")
  pickupCity         String?  @map("pickup_city")
  pickupState        String?  @map("pickup_state")
  pickupZip          String?  @map("pickup_zip")
  deliveryCity       String?  @map("delivery_city")
  deliveryState      String?  @map("delivery_state")
  deliveryZip        String?  @map("delivery_zip")
  pickupFrom         DateTime? @map("pickup_from")
  pickupTo           DateTime? @map("pickup_to")
  deliveryFrom       DateTime? @map("delivery_from")
  deliveryTo         DateTime? @map("delivery_to")
  miles              Float?
  category           String?
  equipment          String?
  vehicle            String?
  weight             String?
  price              Float?
  priority           String   @default("NORMAL")
  notes              String?
  documentsJson      String?  @map("documents_json")
  imageUrl           String?  @map("image_url")
  viewUrl            String?  @unique @map("view_url")
  status             String   @default("NEW")
  assignedBrokerId   String?  @map("assigned_broker_id")
  assignedAt         DateTime? @map("assigned_at")
  acceptedAt         DateTime? @map("accepted_at")
  acceptanceDeadline DateTime? @map("acceptance_deadline")
  quoteSentAt        DateTime? @map("quote_sent_at")
  closedAt           DateTime? @map("closed_at")
  emailMessageId     String?  @map("email_message_id")
  receivedAt         DateTime? @map("received_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  emailMessage       EmailMessage? @relation(fields: [emailMessageId], references: [emailMessageId])
  importLogs         ShipmentImportLog[]
  timelineEvents     ShipmentTimelineEvent[]

  @@index([source])
  @@index([status])
  @@index([externalShipmentId])
  @@index([assignedBrokerId])
  @@index([priority])
  @@index([createdAt])
  @@map("shipment_leads")
}

model ShipmentTimelineEvent {
  eventId          String   @id @default(uuid()) @map("event_id")
  shipmentLeadId   String   @map("shipment_lead_id")
  stage            String
  title            String
  message          String?
  actorUserId      String?  @map("actor_user_id")
  metaJson         String?  @map("meta_json")
  createdAt        DateTime @default(now()) @map("created_at")
  shipmentLead     ShipmentLead @relation(fields: [shipmentLeadId], references: [shipmentLeadId], onDelete: Cascade)

  @@index([shipmentLeadId])
  @@index([stage])
  @@index([createdAt])
  @@map("shipment_timeline_events")
}

model ShipmentImportLog {
  logId          String   @id @default(uuid()) @map("log_id")
  eventType      String   @map("event_type")
  message        String
  gmailMessageId String?  @map("gmail_message_id")
  emailMessageId String?  @map("email_message_id")
  shipmentLeadId String?  @map("shipment_lead_id")
  metaJson       String?  @map("meta_json")
  createdAt      DateTime @default(now()) @map("created_at")
  emailMessage   EmailMessage? @relation(fields: [emailMessageId], references: [emailMessageId])
  shipmentLead   ShipmentLead? @relation(fields: [shipmentLeadId], references: [shipmentLeadId])

  @@index([eventType])
  @@index([createdAt])
  @@map("shipment_import_logs")
}

model AssignmentQueueState {
  queueKey           String   @id @default("brokers") @map("queue_key")
  orderedUserIdsJson String   @default("[]") @map("ordered_user_ids_json")
  nextIndex          Int      @default(0) @map("next_index")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("assignment_queue_state")
}

model AssignmentLog {
  logId              String   @id @default(uuid()) @map("log_id")
  shipmentLeadId     String?  @map("shipment_lead_id")
  assignedUserId     String?  @map("assigned_user_id")
  assignedEmployeeId String?  @map("assigned_employee_id")
  eventType          String   @map("event_type")
  message            String
  queueSnapshotJson  String?  @map("queue_snapshot_json")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([shipmentLeadId])
  @@index([assignedUserId])
  @@index([eventType])
  @@index([createdAt])
  @@map("assignment_logs")
}
